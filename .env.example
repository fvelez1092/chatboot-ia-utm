# HTTP service
HOST=0.0.0.0
PORT=5005
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
AUTO_START=false

# UTM AI/RAG backend
AGENT_URL=http://localhost:5000/rag/ask
AGENT_LOGIN_URL=http://localhost:5000/auth/login
AGENT_USERNAME=whatsapp_bot
AGENT_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA
AGENT_TIMEOUT_MS=600000
RETRY_ATTEMPTS=2
RETRY_BASE_MS=5000

# WhatsApp
SESSION_ID=AGENTE_IA
SESSIONS_DIR=.sessions
HEADLESS=true
IGNORE_GROUPS=true

# Misma clave pública RS256 utilizada por api_ia_utm
JWT_PUBLIC_KEY_PATH=/ruta/absoluta/api_ia_utm/secrets/jwt-public.pem
